<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- THIS MODULE IS UNSCANNED. The Light SDK plugin skips any module named
         `server` (LightSdkPlugin.SDK_MODULES) for its source scan, its manifest
         check and its dependency allowlist. That is the only reason the service
         below can exist in this APK at all: the plugin generates the tool
         manifest from lighttool.toml and rejects a hand-written one, so a
         privileged component has to arrive merged from a module it never looks
         at. See ../system/server/AndroidManifest.xml for the original. -->

    <!-- The strip is an overlay window owned by the accessibility service, so
         it needs no appop of its own. This permission is for the *launch*: on
         Android 14 a background activity start is dropped silently without it,
         so without this grant a swipe would animate and open nothing. LightOS
         ships no screen that grants it, so it is set once over adb:

           adb shell appops set com.loosewire.notifications SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <service
            android:name=".SwipeDownService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/swipe_down_service" />
        </service>
    </application>

</manifest>
